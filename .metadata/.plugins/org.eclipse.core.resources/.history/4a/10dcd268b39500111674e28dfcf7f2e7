package com.Automationframework.base;

import org.testng.ITestContext;
import org.testng.ITestListener;
import org.testng.ITestResult;

public class Listners implements ITestListener {
	
	
		

	    @Override
	    public void onStart(ITestContext context) {
	        ExtentReport.genExtentReport(); // start report once per suite
	    }
	    
	    @Override
	    public void onFinish(ITestContext context) {
	        ExtentReport.flushReport(); // flush report at the end
	    }
	    @Override
	    public void onTestStart(ITestResult result) {
	    	ExtentReport.genExtentReport();
	    	 ExtentReport.createTest(result.getName());
	         ExtentReport.getTest().info("Starting test: " + result.getName());
	    }

	    @Override
	    public void onTestSuccess(ITestResult result) {
	        ExtentReport.getTest().pass("Test passed: " + result.getName());
	    }

	    @Override
	    public void onTestFailure(ITestResult result) {
	        
	        ExtentReport.getTest().fail("Test failed: " + result.getName());
	        ExtentReport.getTest().fail(result.getThrowable());
	    }
	    
	    
	}


