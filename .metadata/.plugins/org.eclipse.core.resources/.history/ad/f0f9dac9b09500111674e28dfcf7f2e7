package com.Automationframework.base;

import java.io.File;
import java.io.IOException;
import java.time.Duration;
import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;

import org.apache.commons.io.FileUtils;
import org.openqa.selenium.OutputType;
import org.openqa.selenium.TakesScreenshot;
import org.openqa.selenium.TimeoutException;
import org.openqa.selenium.WebDriver;
import org.openqa.selenium.WebElement;
import org.openqa.selenium.support.ui.ExpectedCondition;
import org.openqa.selenium.support.ui.ExpectedConditions;
import org.openqa.selenium.support.ui.WebDriverWait;

import com.aventstack.extentreports.ExtentTest;

public class Utility extends Base {
	
	public static ReadConfig prop= new ReadConfig();

	public static void logReport(String message, boolean takescreenshot, WebDriver driver) {
	    // Format the current time
	    DateTimeFormatter formatter = DateTimeFormatter.ofPattern("yyyy-MM-dd HH:mm:ss");
	    String timestamp = LocalDateTime.now().format(formatter);

	    // Final message with timestamp
	    String logMessage = "[" + timestamp + "] " + message;

	    if (takescreenshot) {
	        String screenshotPath = takescreenshot(driver); // now returns String
	        ExtentReport.getTest().info(logMessage)
	                    .addScreenCaptureFromPath(screenshotPath);
	    } else {
	        ExtentReport.getTest().info(logMessage);
	    }

	    System.out.println(logMessage);
	}

	public static String takescreenshot(WebDriver driver) {
	    // Unique filename with timestamp
	    String fileName = "screenshot_" + System.currentTimeMillis() + ".png";

	    // Capture screenshot
	    File src = ((TakesScreenshot) driver).getScreenshotAs(OutputType.FILE);

	    // Destination path (make sure folder exists)
	    String destPath = "./Report/screenshots/" + fileName;
	    File destFile = new File(destPath);

	    try {
	        FileUtils.copyFile(src, destFile);
	        System.out.println("Screenshot saved at: " + destFile.getAbsolutePath());
	    } catch (IOException e) {
	        e.printStackTrace();
	    }

	    return destPath; // return String path
	}
	
	public static void waitUntilElementLoad(WebDriver driver, Duration timeout, WebElement element) {
	    if (element == null) {
	    	logReport("Element is null, cannot wait.",  true,  driver);
	        return;
	    }

	    try {
	        WebDriverWait wait = new WebDriverWait(driver, timeout);
	        wait.until(ExpectedConditions.elementToBeClickable(element));
	        logReport("Element is clickable and ready.",true,driver);
	    } catch (TimeoutException te) {
	        logReport("Timeout: Element not clickable within " + timeout.getSeconds() + " seconds.",true,driver);
	    } catch (Exception e) {
	    	logReport("Unexpected error while waiting for element: " + e.getMessage(), true, driver);
	    }
	}	
	
	public static void clickElement(WebElement element, String message) {
	    if (element == null) {
	        logReport("Element is null. Cannot perform click: " + message,true,driver);
	        return;
	    }

	    try {
	        if (element.isDisplayed() && element.isEnabled()) {
	            element.click();
	            logReport(message + " - element clicked successfully.",true,driver);
	        } else {
	            logReport(message + " - element not clickable (not displayed or disabled).",true,driver);
	        }
	    } catch (Exception e) {
	        logReport("Failed to click on element: " + message + " | Exception: " + e.getMessage(),true,driver);
	    }
	}	
	
	
	public static void enterValueTextInputField(WebElement element, String value) {
	    if (element == null) {
	        logReport("Element is null. Cannot enter value: " + value,true,driver);
	        return;
	    }

	    try {
	        if (element.isDisplayed() && element.isEnabled()) {
	            element.clear();
	            element.sendKeys(value);
	            logReport("Value '" + value + "' entered successfully in input field.",true,driver);
	        } else {
	            logReport("Element not interactable. Failed to enter value: " + value,true,driver);
	        }
	    } catch (Exception e) {
	        logReport("Failed to enter '" + value + "' in input field. Exception: " + e.getMessage());
	    }
	}
	
	
}
