	public static void waitUntilElementLoad(WebDriver driver, Duration timeout, WebElement element) {
	    if (element == null) {
	        logReport("Element is null, cannot wait.");
	        return;
	    }

	    try {
	        WebDriverWait wait = new WebDriverWait(driver, timeout);
	        wait.until(ExpectedConditions.elementToBeClickable(element));
	        logReport("Element is clickable and ready.");
	    } catch (TimeoutException te) {
	        logReport("Timeout: Element not clickable within " + timeout.getSeconds() + " seconds.");
	    } catch (Exception e) {
	        logReport("Unexpected error while waiting for element: " + e.getMessage());
	    }
	}	
	
	public static void clickElement(WebElement element, String message) {
	    if (element == null) {
	        logReport("Element is null. Cannot perform click: " + message);
	        return;
	    }

	    try {
	        if (element.isDisplayed() && element.isEnabled()) {
	            element.click();
	            logReport(message + " - element clicked successfully.");
	        } else {
	            logReport(message + " - element not clickable (not displayed or disabled).");
	        }
	    } catch (Exception e) {
	        logReport("Failed to click on element: " + message + " | Exception: " + e.getMessage());
	    }
	}	
	
	
	public static void enterValueTextInputField(WebElement element, String value) {
	    if (element == null) {
	        logReport("Element is null. Cannot enter value: " + value);
	        return;
	    }

	    try {
	        if (element.isDisplayed() && element.isEnabled()) {
	            element.clear();
	            element.sendKeys(value);
	            logReport("Value '" + value + "' entered successfully in input field.");
	        } else {
	            logReport("Element not interactable. Failed to enter value: " + value);
	        }
	    } catch (Exception e) {
	        logReport("Failed to enter '" + value + "' in input field. Exception: " + e.getMessage());
	    }
	}
	
	
}
